# Core app
AUTH_SECRET="dev-only-auth-secret-change-me"
NEXTAUTH_SECRET="dev-only-auth-secret-change-me"

# ==================================================
# SUPABASE POSTGRES DATABASE FOR PRISMA
# ==================================================
# Use Supabase Session Pooler for runtime and direct Prisma operations in this project.
# Replace PROJECT_REF, REGION, and DB_PASSWORD with your real values.
DATABASE_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# URL MODE: LOCAL
# NEXTAUTH_URL="http://localhost:3000"
# AUTH_URL="http://localhost:3000"
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# AUTH_TRUST_HOST="true"

# URL MODE: NGROKS
# Replace <your-active-ngrok-subdomain> with your currently running ngrok domain.
# NEXTAUTH_URL="https://<your-active-ngrok-subdomain>.ngrok-free.dev"
# AUTH_URL="https://<your-active-ngrok-subdomain>.ngrok-free.dev"
# NEXT_PUBLIC_APP_URL="https://<your-active-ngrok-subdomain>.ngrok-free.dev"
# AUTH_TRUST_HOST="true"

# Optional OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional SMS notifications
# Keep SMS disabled in local development unless you are testing provider delivery.
SMS_ENABLED="false"

# CountryStateCity API proxy key
COUNTRYSTATECITY_API_KEY=

# SMS Provider
# Options: "semaphore" or "twilio"
SMS_PROVIDER="semaphore"

# Semaphore SMS Configuration
SEMAPHORE_API_KEY=""
SEMAPHORE_SENDER_NAME=""
SEMAPHORE_BASE_URL="https://api.semaphore.co/api/v4/messages"

# Twilio SMS Configuration
# Only needed if SMS_PROVIDER="twilio"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Gmail SMTP Configuration (for password reset OTP emails)
# Use Gmail App Password (not your regular Google password)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Password Reset Configuration
PASSWORD_RESET_OTP_EXPIRES_MINUTES=10

# ==========================================
# SUPABASE POSTGRES DATABASE
# Using Direct Connection
# ==========================================

DATABASE_URL=""

DIRECT_URL=""

# ==========================================
# SUPABASE APP CONFIG
# ==========================================

NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

SUPABASE_SERVICE_ROLE_KEY=""

S3_PDF_BUCKET="ebpls-pdfs"
S3_IMAGE_BUCKET="ebpls-images"