# Core app
DATABASE_URL="file:./prisma/dev.db"
AUTH_SECRET="dev-only-auth-secret-change-me"
NEXTAUTH_SECRET="dev-only-auth-secret-change-me"

# URL MODE: LOCAL
# NEXTAUTH_URL="http://localhost:3000"
# AUTH_URL="http://localhost:3000"
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
# AUTH_TRUST_HOST="true"

# URL MODE: NGROK
# Replace <your-active-ngrok-subdomain> with your currently running ngrok domain.
# NEXTAUTH_URL="https://<your-active-ngrok-subdomain>.ngrok-free.dev"
# AUTH_URL="https://<your-active-ngrok-subdomain>.ngrok-free.dev"
# NEXT_PUBLIC_APP_URL="https://<your-active-ngrok-subdomain>.ngrok-free.dev"
# AUTH_TRUST_HOST="true"

# Optional OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional SMS notifications
# Keep SMS disabled in local development unless you are testing provider delivery.
SMS_ENABLED="false"

# CountryStateCity API proxy key
COUNTRYSTATECITY_API_KEY="your-country-state-city-api-key"

# SMS Provider
# Options: "semaphore" or "twilio"
SMS_PROVIDER="semaphore"

# Semaphore SMS Configuration
SEMAPHORE_API_KEY=""
SEMAPHORE_SENDER_NAME=""
SEMAPHORE_BASE_URL="https://api.semaphore.co/api/v4/messages"

# Twilio SMS Configuration
# Only needed if SMS_PROVIDER="twilio"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""