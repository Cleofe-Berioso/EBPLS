# Core app / Auth.js
AUTH_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Database (Prisma)
DATABASE_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=ebpls"
DIRECT_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=ebpls&sslmode=require"

# Supabase app + storage admin
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Storage buckets
S3_PDF_BUCKET="ebpls-pdfs"
S3_IMAGE_BUCKET="ebpls-images"

# Optional Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional address API
COUNTRY_STATE_CITY_API_KEY=""
# Legacy alias supported during migration:
# COUNTRYSTATECITY_API_KEY=""

# Optional SMS notifications
SMS_ENABLED="false"
SMS_PROVIDER="semaphore"

# Semaphore SMS
SEMAPHORE_API_KEY=""
SEMAPHORE_SENDER_NAME=""
SEMAPHORE_BASE_URL="https://api.semaphore.co/api/v4/messages"

# Twilio SMS (required only when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Mail / OTP reset
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
PASSWORD_RESET_OTP_EXPIRES_MINUTES=10