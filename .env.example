# Core app / Auth.js
AUTH_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ==========================================
# DATABASE - Supabase PostgreSQL + Prisma
# ==========================================
# Runtime: use Supabase Session Pooler (port 5432)
# Username format for pooler: postgres.<PROJECT_REF>
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require&schema=ebpls"
#
# Migrations/DDL: use Direct connection (host db.<PROJECT_REF>.supabase.co)
# Username format for direct host: postgres
DIRECT_URL="postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require&schema=ebpls"

# Supabase app + storage admin
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Storage: "supabase" (remote buckets) or "local" (.uploads folder — dev only)
STORAGE_DRIVER="supabase"
S3_PDF_BUCKET="ebpls-pdfs"
S3_IMAGE_BUCKET="ebpls-images"
# LOCAL_UPLOAD_ROOT=".uploads"

# Optional Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional address API
COUNTRY_STATE_CITY_API_KEY=""
# Legacy alias supported during migration:
# COUNTRYSTATECITY_API_KEY=""

# Optional SMS notifications (permit release + JIT no-permit ticket only).
# SMS_ENABLED must trim to "true" (case-insensitive). Missing, false, empty, or any other value keeps SMS disabled.
# Registration and password-reset OTP are email-only (GMAIL_* below), not controlled by SMS_ENABLED.
SMS_ENABLED="false"
SMS_PROVIDER="semaphore"

# Semaphore SMS
SEMAPHORE_API_KEY=""
SEMAPHORE_SENDER_NAME=""
SEMAPHORE_BASE_URL="https://api.semaphore.co/api/v4/messages"

# Twilio SMS (required only when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Mail / OTP reset (email-only; not SMS)
# Local dev: Gmail SMTP (GMAIL_* below).
# Render free tier blocks SMTP ports — use Resend HTTPS API in production instead.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# Paste app password without spaces, e.g. abcdefghijkl
RESEND_API_KEY=""
# Verified sender in Resend, or onboarding@resend.dev for testing (Resend account email only)
RESEND_FROM="onboarding@resend.dev"
# Optional display name + reply-to (defaults to GMAIL_USER)
MAIL_FROM_NAME="Municipality of Enrique B. Magalona BPLO"
MAIL_REPLY_TO=""
PASSWORD_RESET_OTP_EXPIRES_MINUTES=10

# Renewal email notifications (Batch 6)
RENEWAL_EMAIL_ENABLED="false"
RENEWAL_UPCOMING_DAYS=30
CRON_SECRET=""
SUPPORT_EMAIL="support@bplo.gov.ph"

# JIT no-permit notice (Batch 7A)
JIT_NO_PERMIT_INSPECTING_OFFICE="Joint Inspection Team (JIT) — Business Permit and Licensing Office, Municipality of Enrique B. Magalona"

# Revocation email notifications (Batch 7B)
REVOCATION_EMAIL_ENABLED="false"