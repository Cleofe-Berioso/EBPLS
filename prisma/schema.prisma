// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  APPLICANT
  BPLO
  SUPER_ADMIN
  DEPARTMENT_HEAD
  JIT
}

enum ApplicationType {
  NEW
  RENEWAL
  CLOSURE
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  DEPARTMENT_HEAD_REVIEW
  DEPARTMENT_HEAD_APPROVED
  ASSESSED
  APPROVED_FOR_PAYMENT
  PAID
  FOR_RELEASE
  RELEASED
  REVOCATION_REVIEW
  REVOKED
  RETURNED_FOR_CORRECTION
  REJECTED
}

enum NonComplianceType {
  GOVERNMENT_AGENCY_RELATED
  RENEWAL_RELATED
}

enum ViolationSeverity {
  MINOR
  MAJOR
  SEVERE
}

enum ComplianceCaseStatus {
  NONE
  FLAGGED_UNSETTLED
  SETTLED
  EXPIRED_UNSETTLED
  FORCED_CLOSURE_PENDING
  CLOSED_NON_COMPLIANT
}

enum ClosureType {
  RETIREMENT
  NON_COMPLIANT_RELATED
  OTHERS
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  firstName    String?
  middleName   String?
  lastName     String?
  suffix       String?
  profileImageStoragePath String?
  profileImageFileName String?
  profileImageBucket String?
  profileImageMimeType String?
  profileImageSize Int?
  profileImageSizeBytes Int?
  profileImageUpdatedAt DateTime?
  profileImageUploadedAt DateTime?
  passwordHash String
  role         Role     @default(APPLICANT)
  isActive     Boolean  @default(true)
  applications BusinessApplication[] @relation("ApplicantApplications")
  businessRecords BusinessRecord[]
  submittedLocations BusinessLocation[] @relation("LocationSubmittedBy")
  verifiedLocations  BusinessLocation[] @relation("LocationVerifiedBy")
  historyEntries ApplicationHistory[] @relation("HistoryActor")
  assessmentsComputed FeeAssessment[] @relation("AssessmentComputedBy")
  reviewedPaymentReferences PaymentReference[] @relation("PaymentReviewedBy")
  permitsPrepared PermitIssuance[] @relation("PermitPreparedBy")
  permitsReleased PermitIssuance[] @relation("PermitReleasedBy")
  inspections      Inspection[]     @relation("InspectionInspector")
  inspectionDecisions Inspection[]  @relation("InspectionDecider")
  revocationSettlementRecords Inspection[] @relation("InspectionRevocationSettledBy")
  complianceSettlementRecords Inspection[] @relation("InspectionSettledBy")
  forcedClosureRecords Inspection[] @relation("InspectionForcedClosureBy")
  feeConfigurationUpdates FeeConfigurationItem[] @relation("FeeConfigUpdatedBy")
  systemFeeSettingUpdates SystemFeeSetting[] @relation("SystemFeeSettingUpdatedBy")
  renewalExtensionUpdates RenewalExtension[] @relation("RenewalExtensionUpdatedBy")
  smsDeliveryLogs SmsDeliveryLog[] @relation("SmsDeliveryLogApplicant")
  reassessmentRequests FeeAssessment[] @relation("FeeAssessmentReassessmentRequestedBy")
  jitNoPermitRecords JitNoPermitRecord[] @relation("JitNoPermitRecordCreatedBy")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
  
model BusinessRecord {
  id                 String   @id @default(cuid())
  applicantId        String
  businessType       String
  registrationNumber String   @unique
  tin                String
  businessName       String
  tradeName          String
  ownerName          String
  ownerFirstName     String?
  ownerMiddleName    String?
  ownerLastName      String?
  ownerSuffix        String?
  sex                String?
  nationality        String
  email              String
  phone              String
  mainOfficeAddress  String
  businessAddress    String
  sameAsMainOffice   Boolean  @default(true)
  businessArea       String?
  totalFloorArea     String?
  totalEmployees     String?
  maleEmployees      String?
  femaleEmployees    String?
  employeesWithinMunicipality String?
  deliveryVehicles   String?
  propertyOwnership  String?
  taxDeclarationNumber String?
  propertyIdentificationNumber String?
  taxIncentives      String?
  businessActivity   String?
  lineOfBusiness     String?
  assetSize          String?
  isMarket           Boolean  @default(false)
  isAgriculture      Boolean  @default(false)
  permitExpirationDate DateTime?
  businessStatus     BusinessRecordStatus @default(ACTIVE)
  closedAt           DateTime?
  closureApplicationId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  applicant    User                 @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  applications BusinessApplication[]
  location     BusinessLocation?
  inspections  Inspection[]

  @@index([applicantId])
}

enum BusinessRecordStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum BusinessLocationStatus {
  PENDING
  VERIFIED
  NEEDS_CORRECTION
}

model BusinessLocation {
  id               String                 @id @default(cuid())
  businessRecordId String                 @unique
  latitude         Float
  longitude        Float
  address          String?
  barangay         String?
  status           BusinessLocationStatus @default(PENDING)
  submittedById    String
  verifiedById     String?
  remarks          String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  businessRecord BusinessRecord @relation(fields: [businessRecordId], references: [id], onDelete: Cascade)
  submittedBy   User           @relation("LocationSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  verifiedBy    User?          @relation("LocationVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([submittedById])
  @@index([verifiedById])
}

model BusinessApplication {
  id                String            @id @default(cuid())
  applicationNumber String            @unique
  applicantId       String
  businessRecordId  String?
  applicationType   ApplicationType
  status            ApplicationStatus @default(DRAFT)
  formData          Json
  closureType       ClosureType?
  closureTypeOtherReason String?
  submittedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  applicant     User                @relation("ApplicantApplications", fields: [applicantId], references: [id], onDelete: Cascade)
  businessRecord BusinessRecord?    @relation(fields: [businessRecordId], references: [id], onDelete: SetNull)
  documents     ApplicationDocument[]
  paymentReferences PaymentReference[]
  history       ApplicationHistory[]
  feeAssessment FeeAssessment?
  permitIssuance PermitIssuance?
  smsDeliveryLogs SmsDeliveryLog[]
  inspections   Inspection[]

  @@index([applicantId, createdAt])
  @@index([applicantId, status])
}

enum PermitDocumentType {
  BUSINESS_PERMIT
  CLOSURE_CERTIFICATE
}

enum InspectionComplianceStatus {
  COMPLIANT
  NON_COMPLIANT
}

enum InspectionStatus {
  COMPLIANT
  NON_COMPLIANT
  DH_VERIFICATION_PENDING
  VERIFIED_COMPLIANT
  VERIFIED_NON_COMPLIANT
  REVOCATION_REVIEW
  REVOCATION_DENIED
  REVOKED
}

enum RevocationDecision {
  APPROVED
  DENIED
}

model Inspection {
  id                         String                     @id @default(cuid())
  businessRecordId           String
  applicationId              String?
  inspectorId                String
  complianceStatus           InspectionComplianceStatus
  status                     InspectionStatus
  comment                    String?
  evidenceFileName           String?
  evidenceStoragePath        String?
  evidenceBucket             String?
  evidenceMimeType           String?
  evidenceSizeBytes          Int?
  revocationDecision         RevocationDecision?
  revocationRemarks          String?
  decidedById                String?
  decidedAt                  DateTime?
  revocationSettledAt        DateTime?
  revocationSettlementRemarks String?
  revocationSettledById      String?
  nonComplianceType          NonComplianceType?
  violationSeverity          ViolationSeverity?
  isSettled                  Boolean            @default(false)
  settledAt                  DateTime?
  settlementRemarks          String?
  settledById                String?
  deadlineAt                 DateTime?
  autoClosed                 Boolean            @default(false)
  forcedClosure              Boolean            @default(false)
  forcedClosureAt            DateTime?
  forcedClosureById          String?
  complianceCaseStatus       ComplianceCaseStatus @default(NONE)
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  businessRecord BusinessRecord       @relation(fields: [businessRecordId], references: [id], onDelete: Cascade)
  application    BusinessApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  inspector      User                 @relation("InspectionInspector", fields: [inspectorId], references: [id], onDelete: Restrict)
  decidedBy      User?                @relation("InspectionDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  revocationSettledBy User?           @relation("InspectionRevocationSettledBy", fields: [revocationSettledById], references: [id], onDelete: SetNull)
  settledBy      User?                @relation("InspectionSettledBy", fields: [settledById], references: [id], onDelete: SetNull)
  forcedClosureBy User?               @relation("InspectionForcedClosureBy", fields: [forcedClosureById], references: [id], onDelete: SetNull)

  @@index([businessRecordId, createdAt])
  @@index([applicationId, createdAt])
  @@index([inspectorId, createdAt])
  @@index([decidedById, createdAt])
  @@index([status, createdAt])
  @@index([revocationSettledAt, createdAt])
  @@index([complianceCaseStatus, createdAt])
  @@index([settledAt, createdAt])
  @@index([forcedClosureAt, createdAt])
}

enum PermitIssuanceStatus {
  PREPARED
  FOR_RELEASE
  RELEASED
}

model PermitIssuance {
  id            String               @id @default(cuid())
  applicationId String               @unique
  documentNumber String              @unique
  documentType  PermitDocumentType
  status        PermitIssuanceStatus @default(PREPARED)
  issuedAt      DateTime             @default(now())
  releasedAt    DateTime?
  preparedById  String
  releasedById  String?
  documentPath  String?
  remarks       String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  application BusinessApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  preparedBy  User                @relation("PermitPreparedBy", fields: [preparedById], references: [id], onDelete: Restrict)
  releasedBy  User?               @relation("PermitReleasedBy", fields: [releasedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([applicationId, status])
}

model ApplicationDocument {
  id            String   @id @default(cuid())
  applicationId String
  documentName  String
  fileName      String
  storagePath   String
  bucket        String?
  filePath      String?
  originalName  String?
  mimeType      String
  sizeBytes     Int
  fileSize      Int?
  uploadedAt    DateTime @default(now())

  application BusinessApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model ApplicationHistory {
  id            String            @id @default(cuid())
  applicationId String
  actorId       String?
  actorRole     Role?
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  remarks       String?
  createdAt     DateTime          @default(now())

  application BusinessApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor       User?               @relation("HistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
}

enum FeeAssessmentStatus {
  DRAFT
  GENERATED
}

enum PaymentReferenceStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentSettlementStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PaymentFrequency {
  ANNUAL
  BI_ANNUAL
  QUARTERLY
}

enum SmsDeliveryStatus {
  SKIPPED
  SENT
  FAILED
}

model SmsDeliveryLog {
  id               String            @id @default(cuid())
  applicationId    String
  applicantId      String?
  phoneNumber      String?
  provider         String
  status           SmsDeliveryStatus
  messageBody      String
  providerResponse String?
  createdAt        DateTime          @default(now())

  application BusinessApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicant   User?               @relation("SmsDeliveryLogApplicant", fields: [applicantId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@index([applicantId, createdAt])
  @@index([status, createdAt])
}

model FeeAssessment {
  id                    String              @id @default(cuid())
  applicationId         String              @unique
  assessmentNumber      String              @unique
  status                FeeAssessmentStatus @default(DRAFT)
  paymentFrequency      PaymentFrequency    @default(ANNUAL)
  annualAssessedAmount  Decimal             @default(0)
  releasePaymentAmount  Decimal             @default(0)
  amountPaid            Decimal             @default(0)
  remainingBalance      Decimal             @default(0)
  paymentStatus         PaymentSettlementStatus @default(UNPAID)
  mayorsPermitFee       Decimal             @default(0)
  regulatoryFees        Decimal             @default(0)
  additionalCharges     Decimal             @default(0)
  penalties             Decimal             @default(0)
  surcharge             Decimal             @default(0)
  interest              Decimal             @default(0)
  closurePaymentDues    Decimal             @default(0)
  closureCertificateFee Decimal             @default(0)
  arrears               Decimal             @default(0)
  otherCharges          Decimal             @default(0)
  totalAmount           Decimal             @default(0)
  remarks               String?
  computedById          String?
  generatedAt           DateTime?
  reassessmentRequestedAt DateTime?
  reassessmentRequestedById String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  application  BusinessApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  computedBy   User?               @relation("AssessmentComputedBy", fields: [computedById], references: [id], onDelete: SetNull)
  reassessmentRequestedBy User?    @relation("FeeAssessmentReassessmentRequestedBy", fields: [reassessmentRequestedById], references: [id], onDelete: SetNull)
  lineItems    FeeAssessmentLineItem[]

  @@index([applicationId])
  @@index([reassessmentRequestedAt])
}

model FeeAssessmentLineItem {
  id               String        @id @default(cuid())
  feeAssessmentId  String
  description      String
  amount           Decimal       @default(0)
  sortOrder        Int           @default(0)
  isSystemGenerated Boolean      @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  feeAssessment FeeAssessment @relation(fields: [feeAssessmentId], references: [id], onDelete: Cascade)

  @@index([feeAssessmentId, sortOrder])
}

model PaymentReference {
  id                String               @id @default(cuid())
  applicationId     String
  transactionNumber String               @unique
  amountPaid        Decimal              @default(0)
  paymentDate       DateTime
  proofFileName     String
  proofStoragePath  String
  proofBucket       String?
  proofMimeType     String
  proofSizeBytes    Int
  status            PaymentReferenceStatus @default(PENDING)
  reviewerRemarks   String?
  submittedAt       DateTime             @default(now())
  reviewedAt        DateTime?
  reviewedById      String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  application BusinessApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewedBy  User?               @relation("PaymentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([applicationId, submittedAt])
  @@index([status, submittedAt])
}

model FeeConfigurationItem {
  id             String   @id @default(cuid())
  category       String
  classification String
  amount         Decimal  @default(0)
  isActive       Boolean  @default(true)
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  updatedBy User? @relation("FeeConfigUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([category, classification])
  @@index([category, isActive])
}

model SystemFeeSetting {
  id                              String   @id @default(cuid())
  renewalSurchargePercent         Float    @default(25)
  monthlyInterestPercent          Float    @default(2)
  liquorTobaccoAddOnPercent       Float    @default(25)
  powerDistributionFixedFee       Decimal  @default(10000)
  privatePortFixedFee             Decimal  @default(50000)
  jitPortalEnabled                Boolean  @default(true)
  renewalComplianceMinorPenalty   Decimal  @default(0)
  renewalComplianceMajorPenalty   Decimal  @default(0)
  renewalComplianceSeverePenalty  Decimal  @default(0)
  updatedById                     String?
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  updatedBy User? @relation("SystemFeeSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model RenewalExtension {
  id             String   @id @default(cuid())
  title          String
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean  @default(true)
  waiveSurcharge Boolean  @default(true)
  waiveInterest  Boolean  @default(false)
  remarks        String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  updatedBy User? @relation("RenewalExtensionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([isActive, startDate, endDate])
}

model JitNoPermitRecord {
  id             String   @id @default(cuid())
  businessName   String
  personAttended String
  lineOfBusiness String
  remarks        String?
  latitude       Float
  longitude      Float
  address        String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdBy User @relation("JitNoPermitRecordCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([createdById, createdAt])
  @@index([businessName])
  @@index([createdAt])
}

model AuditLog {
  id                 String    @id @default(cuid())
  actorId            String?
  actorName          String?
  actorRole          String?
  action             String
  module             String
  entityType         String
  entityId           String?
  applicationId      String?
  businessRecordId   String?
  inspectionId       String?
  paymentReferenceId String?
  documentId         String?
  beforeStatus       String?
  afterStatus        String?
  description        String?
  metadata           Json?
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime  @default(now())

  @@index([actorId, createdAt])
  @@index([applicationId, createdAt])
  @@index([businessRecordId, createdAt])
  @@index([action, createdAt])
  @@index([module, createdAt])
  @@index([entityType, createdAt])
  @@index([createdAt])
}

model PasswordResetOtp {
  id         String    @id @default(cuid())
  email      String
  otpHash    String
  expiresAt  DateTime
  verifiedAt DateTime?
  usedAt     DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}
