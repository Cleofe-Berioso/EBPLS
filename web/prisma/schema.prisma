generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// MODULE 1: User & Access Management
// ============================================================================

enum Role {
  APPLICANT
  BPLO_OFFICE
  MTO
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

model User {
  id                  String        @id @default(cuid())
  email               String        @unique
  emailVerified       DateTime?
  password            String
  firstName           String
  lastName            String
  middleName          String?
  phone               String?
  role                Role          @default(APPLICANT)
  status              AccountStatus @default(PENDING_VERIFICATION)
  avatar              String?
  twoFactorEnabled    Boolean       @default(false)
  twoFactorSecret     String?
  lastLoginAt         DateTime?
  failedLoginAttempts Int           @default(0)
  lockedUntil         DateTime?
  renewalEligible     Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // Relations
  applications      Application[]     @relation("ApplicantApplications")
  documents         Document[]        @relation("UploadedDocuments")
  activityLogs      ActivityLog[]
  otpTokens         OtpToken[]
  sessions          Session[]
  reviewActions     ReviewAction[]
  issuanceActions   PermitIssuance[]  @relation("IssuedByUser")
  payments          Payment[]         @relation("UserPayments")

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model OtpToken {
  id        String   @id @default(cuid())
  token     String
  type      String
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("otp_tokens")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

// ============================================================================
// MODULE 2: Permit Application Management
// ============================================================================

enum ApplicationType {
  NEW
  RENEWAL
  CLOSURE
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  ENDORSED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum ClosureReason {
  RETIREMENT
  RELOCATION
  SOLD_TRANSFERRED
  LIQUIDATION
  CALAMITY
  OTHER
}

enum DocumentType {
  PROOF_OF_REGISTRATION
  PROOF_OF_OWNERSHIP
  LOCATION_PLAN
  FSIC
  AFFIDAVIT
  BARANGAY_CLEARANCE
  OTHER
}

model Application {
  id                 String             @id @default(cuid())
  applicationNumber  String             @unique
  type               ApplicationType
  status             ApplicationStatus  @default(DRAFT)

  // Applicant info
  applicantId        String
  applicant          User               @relation("ApplicantApplications", fields: [applicantId], references: [id], onDelete: Cascade)

  // Business info
  businessName       String
  businessType       String
  lineOfBusiness     String?
  businessAddress    String
  businessBarangay   String?
  businessCity       String?
  businessProvince   String?
  businessZipCode    String?
  businessPhone      String?
  businessEmail      String?
  dtiSecRegistration String?
  tinNumber          String?
  sssNumber          String?
  businessArea       Float?
  numberOfEmployees  Int?
  capitalInvestment  Decimal?           @db.Decimal(15, 2)
  assetValue         Decimal?           @db.Decimal(15, 2)
  monthlyRental      Decimal?           @db.Decimal(15, 2)
  grossSales         Decimal?           @db.Decimal(15, 2)

  // Owner personal info
  ownerBirthdate     DateTime?
  ownerResidenceAddress String?
  ownerPhone         String?

  additionalData     Json?
  acknowledgedOutstandingFees Boolean?

  // Renewal reference
  previousPermitId   String?
  previousPermit     Permit?            @relation("RenewalOfPermit", fields: [previousPermitId], references: [id], onDelete: SetNull)

  // Verification & Payment State
  documentVerified     Boolean          @default(false)
  applicationApproved  Boolean          @default(false)
  paymentConfirmed     Boolean          @default(false)

  // Timestamps
  submittedAt        DateTime?
  reviewedAt         DateTime?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  documents          Document[]
  history            ApplicationHistory[]
  reviewActions      ReviewAction[]
  permit             Permit?            @relation("PermitApplication")
  payments           Payment[]
  clearances         Clearance[]        @relation("ApplicationClearances")
  businessLocation   BusinessLocation?

  @@index([applicantId])
  @@index([status])
  @@index([applicationNumber])
  @@index([createdAt])
  @@map("applications")
}

model BusinessLocation {
  id              String      @id @default(cuid())
  applicationId   String      @unique
  latitude        Float
  longitude       Float
  label           String?
  businessType    String?
  markerColor     String?     @default("blue")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("business_locations")
}

model ApplicationHistory {
  id             String             @id @default(cuid())
  applicationId  String
  previousStatus ApplicationStatus?
  newStatus      ApplicationStatus
  comment        String?
  changedBy      String?
  createdAt      DateTime           @default(now())

  application    Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([createdAt])
  @@map("application_history")
}

model ReviewAction {
  id            String      @id @default(cuid())
  applicationId String
  reviewerId    String
  action        String
  comment       String?
  createdAt     DateTime    @default(now())

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer      User        @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([reviewerId])
  @@map("review_actions")
}

// ============================================================================
// MODULE 3: Digital Document Management
// ============================================================================

enum DocumentStatus {
  UPLOADED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

model Document {
  id              String         @id @default(cuid())
  applicationId   String
  uploadedBy      String
  fileName        String
  originalName    String
  mimeType        String
  fileSize        Int
  filePath        String
  documentType    DocumentType   @default(OTHER)
  status          DocumentStatus @default(UPLOADED)
  version         Int            @default(1)
  verifiedBy      String?
  verifiedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  application     Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  uploader        User           @relation("UploadedDocuments", fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([documentType])
  @@index([status])
  @@map("documents")
}

// ============================================================================
// MODULE 7: Permit Issuance & Certification
// ============================================================================

enum PermitStatus {
  ACTIVE
  EXPIRED
  REVOKED
  RENEWED
  CLOSED
}

enum IssuanceStatus {
  PREPARED
  ISSUED
  RELEASED
  COMPLETED
}

model Permit {
  id              String        @id @default(cuid())
  permitNumber    String        @unique
  applicationId   String        @unique
  businessName    String
  businessAddress String
  ownerName       String
  issueDate       DateTime
  expiryDate      DateTime
  status          PermitStatus  @default(ACTIVE)
  permitData      Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  application     Application   @relation("PermitApplication", fields: [applicationId], references: [id], onDelete: Cascade)
  issuance        PermitIssuance?
  renewals        Application[] @relation("RenewalOfPermit")

  @@index([permitNumber])
  @@index([status])
  @@index([expiryDate])
  @@map("permits")
}

model PermitIssuance {
  id                    String         @id @default(cuid())
  permitId              String         @unique
  issuedById            String
  status                IssuanceStatus @default(PREPARED)
  issuedAt              DateTime?
  releasedAt            DateTime?
  completedAt           DateTime?
  staffNotes            String?

  // P7.2: Mayor Signing (offline process tracked in system)
  // For NEW/RENEWAL: permits must be signed by Mayor before release
  // For CLOSURE: no Mayor signing required
  mayorSigningStatus    String         @default("NOT_REQUIRED")  // NOT_REQUIRED | PENDING | SIGNED | HELD
  mayorSignedAt         DateTime?      // When Mayor signed (set by BPLO staff after offline signing)
  mayorSignedBy         String?        // Name/title of Mayor (text, not FK to User, since Mayor isn't in system)
  mayorSigningRemarks   String?        // Hold/return remarks from Mayor

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  permit                Permit         @relation(fields: [permitId], references: [id], onDelete: Cascade)
  issuedBy              User           @relation("IssuedByUser", fields: [issuedById], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([issuedById])
  @@index([mayorSigningStatus])
  @@map("permit_issuances")
}

// ============================================================================
// SYSTEM SETTINGS
// ============================================================================

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("string")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// ============================================================================
// MODULE 11: Payment System
// ============================================================================

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  GCASH
  MAYA
  BANK_TRANSFER
  OTC
  CASH
}

model Payment {
  id              String        @id @default(cuid())
  applicationId   String
  payerId         String
  amount          Decimal       @db.Decimal(12, 2)
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  transactionId   String?       @unique
  receiptNumber   String?       @unique
  referenceNumber String?
  checkoutUrl     String?
  paidAt          DateTime?
  failedAt        DateTime?
  refundedAt      DateTime?
  notes           String?
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  application     Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  payer           User          @relation("UserPayments", fields: [payerId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([payerId])
  @@index([status])
  @@index([transactionId])
  @@map("payments")
}

// ============================================================================
// WEBHOOK TRACKING (Critical for Idempotency)
// ============================================================================
model WebhookLog {
  id                  String   @id @default(cuid())
  paymongoWebhookId   String   @unique  // PayMongo's unique webhook ID
  eventType           String              // "payment.succeeded", etc.
  status              String   @default("PROCESSED")  // PROCESSED, FAILED, PENDING
  result              Json?               // { permitId, issuanceId, etc. }
  errorMessage        String?
  retryCount          Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([paymongoWebhookId])
  @@index([status])
  @@index([createdAt])
  @@map("webhook_logs")
}

// ============================================================================
// MODULE 3.0: ENDORSEMENT & CLEARANCE OFFICES
// ============================================================================

enum ClearanceStatus {
  PENDING
  CLEARED
  WITH_DEFICIENCY
  FOR_INSPECTION
  RETURNED
}

model ClearanceOffice {
  id                String        @id @default(cuid())
  code              String        @unique
  name              String
  description       String?
  applicationTypes  String[]      // "NEW", "RENEWAL", "CLOSURE"
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  clearances        Clearance[]

  @@index([code])
  @@index([isActive])
  @@map("clearance_offices")
}

model Clearance {
  id                String            @id @default(cuid())
  applicationId     String
  officeId          String
  officeCode        String            // Denormalized for quick lookup: SANITARY, ZONING, etc.
  officeName        String            // Denormalized for quick lookup
  status            ClearanceStatus   @default(PENDING)
  remarks           String?
  dateCleared       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  application       Application       @relation("ApplicationClearances", fields: [applicationId], references: [id], onDelete: Cascade)
  office            ClearanceOffice   @relation(fields: [officeId], references: [id], onDelete: Restrict)

  @@unique([applicationId, officeId])
  @@index([applicationId])
  @@index([officeId])
  @@index([status])
  @@map("clearances")
}