# ============================================================================
# Online Business Permit System — Example Environment
# Copy to .env and replace placeholders for your environment.
# ============================================================================

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@db-host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db-host:5432/postgres"

# ── Supabase API ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ── NextAuth / Auth.js ──────────────────────────────────────────────────────
AUTH_SECRET="replace-with-a-strong-secret"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:8000"

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:8000"
NEXT_PUBLIC_APP_NAME="Online Business Permit System"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NODE_ENV="development"

# ── File Storage (S3 / MinIO) ──────────────────────────────────────────────
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="ap-southeast-1"
S3_PDF_BUCKET="ebpls-pdfs"
S3_IMAGE_BUCKET="ebpls-images"

# Optional local mock mode for development only.
# Use this when MinIO / S3 is intentionally unavailable.
# STORAGE_DRIVER="local"
